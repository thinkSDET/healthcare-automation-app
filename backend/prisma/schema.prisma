generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  PHARMACIST
  PATIENT
  SUPPORT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(VIEWER)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  accountSecurity     AccountSecurity?
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id          Int           @id @default(autoincrement())
  medicalId   String        @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  email       String?
  phone       String
  address     String?
  bloodGroup  String?
  status      PatientStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  appointments Appointment[]
  dependents   PatientDependent[]
  documents    PatientDocument[]
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Doctor {
  id             Int          @id @default(autoincrement())
  doctorCode     String       @unique
  firstName      String
  lastName       String
  specialization String
  licenseNumber  String       @unique
  email          String       @unique
  phone          String
  experience     Int
  status         DoctorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointments Appointment[]
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
}

model Appointment {
  id            Int               @id @default(autoincrement())
  appointmentNo String            @unique
  patientId     Int
  doctorId      Int
  appointmentAt DateTime
  duration      Int               @default(30)
  type          AppointmentType   @default(IN_PERSON)
  status        AppointmentStatus @default(SCHEDULED)
  reason        String
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountSecurity {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientDependent {
  id           Int       @id @default(autoincrement())
  patientId    Int
  firstName    String
  lastName     String
  relationship String
  dateOfBirth  DateTime?
  gender       Gender?
  phone        String?
  email        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientDocument {
  id           Int      @id @default(autoincrement())
  patientId    Int
  originalName String
  storedName   String   @unique
  documentType String
  mimeType     String
  size         Int
  filePath     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}
