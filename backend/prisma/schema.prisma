generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  PHARMACIST
  PATIENT
  SUPPORT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(VIEWER)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  accountSecurity     AccountSecurity?
  patient             Patient?
  refillRequestsCreated  PrescriptionRefillRequest[] @relation("RefillRequestedBy")
  refillRequestsReviewed PrescriptionRefillRequest[] @relation("RefillReviewedBy")
  appointmentRequestsCreated  AppointmentRequest[] @relation("AppointmentRequestedBy")
  appointmentRequestsReviewed AppointmentRequest[] @relation("AppointmentReviewedBy")
  auditEvents                 AuditEvent[]
  stockMovements              StockMovement[]
  replenishmentRequestsCreated  ReplenishmentRequest[] @relation("ReplenishmentRequestedBy")
  replenishmentRequestsReviewed ReplenishmentRequest[] @relation("ReplenishmentReviewedBy")
  labTestOrdersCreated          LabTestOrder[] @relation("LabTestOrderCreatedBy")
  labTestOrdersAcknowledged     LabTestOrder[] @relation("LabTestOrderAcknowledgedBy")
  labTestOrdersResultUploaded   LabTestOrder[] @relation("LabTestOrderResultUploadedBy")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Patient {
  id          Int           @id @default(autoincrement())
  userId      Int?          @unique
  medicalId   String        @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  email       String?
  phone       String
  address     String?
  bloodGroup  String?
  status      PatientStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user                User? @relation(fields: [userId], references: [id])
  appointments      Appointment[]
  dependents        PatientDependent[]
  documents         PatientDocument[]
  emergencyContact  PatientEmergencyContact?
  medicalProfile   PatientMedicalProfile?
  prescriptions Prescription[]
  orders        Order[]
  refillRequests PrescriptionRefillRequest[]
  appointmentRequests AppointmentRequest[]
  labTestOrders LabTestOrder[]
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Doctor {
  id             Int          @id @default(autoincrement())
  doctorCode     String       @unique
  firstName      String
  lastName       String
  specialization String
  licenseNumber  String       @unique
  email          String       @unique
  phone          String
  experience     Int
  status         DoctorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointments Appointment[]
  prescriptions Prescription[]
  appointmentRequests AppointmentRequest[]
  labTestOrders LabTestOrder[]
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
}

model Appointment {
  id            Int               @id @default(autoincrement())
  appointmentNo String            @unique
  patientId     Int
  doctorId      Int
  appointmentAt DateTime
  duration      Int               @default(30)
  type          AppointmentType   @default(IN_PERSON)
  status        AppointmentStatus  @default(SCHEDULED)
  reason        String
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  appointmentRequest AppointmentRequest?
  labTestOrders LabTestOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentAt])
}

enum AppointmentRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model AppointmentRequest {
  id                Int                      @id @default(autoincrement())
  requestNo         String                   @unique
  patientId         Int
  doctorId          Int
  requestedAt       DateTime
  duration          Int                      @default(30)
  type              AppointmentType          @default(IN_PERSON)
  reason            String
  notes             String?
  status            AppointmentRequestStatus @default(SUBMITTED)
  requestedByUserId Int
  reviewedByUserId  Int?
  rejectionReason   String?
  reviewedAt        DateTime?
  appointmentId     Int?                     @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  requestedBy User         @relation("AppointmentRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy  User?        @relation("AppointmentReviewedBy", fields: [reviewedByUserId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([requestedAt])
  @@index([patientId, doctorId, requestedAt, status])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountSecurity {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientDependent {
  id           Int       @id @default(autoincrement())
  patientId    Int
  firstName    String
  lastName     String
  relationship String
  dateOfBirth  DateTime?
  gender       Gender?
  phone        String?
  email        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientDocument {
  id           Int      @id @default(autoincrement())
  patientId    Int
  originalName String
  storedName   String   @unique
  documentType String
  mimeType     String
  size         Int
  filePath     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labTestOrderResult LabTestOrder? @relation("LabTestOrderResultDocument")

  @@index([patientId])
}

model PatientEmergencyContact {
  id             Int      @id @default(autoincrement())
  patientId      Int      @unique
  firstName      String
  lastName       String
  relationship   String
  phone          String
  alternatePhone String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
model PatientMedicalProfile {
  id                  Int      @id @default(autoincrement())
  patientId           Int      @unique
  medicalConditions   String?
  allergies           String?
  currentMedications  String?
  medicalNotes        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Prescription {
  id             Int                @id @default(autoincrement())
  prescriptionNo String             @unique
  patientId      Int
  doctorId       Int
  prescribedAt   DateTime           @default(now())
  diagnosis      String?
  notes          String?
  status         PrescriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  patient Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor              @relation(fields: [doctorId], references: [id])
  items   PrescriptionItem[]
  refillRequests PrescriptionRefillRequest[]

  @@index([patientId])
  @@index([doctorId])
  @@index([prescribedAt])
}

model PrescriptionItem {
  id             Int      @id @default(autoincrement())
  prescriptionId Int
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  route          String?
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNo         String        @unique
  patientId       Int
  orderDate       DateTime      @default(now())
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  deliveryAddress String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  refillRequest PrescriptionRefillRequest?

  @@index([patientId])
  @@index([orderDate])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productName String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum RefillRequestType {
  REFILL
  RENEWAL
}

enum RefillRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

model PrescriptionRefillRequest {
  id                Int                 @id @default(autoincrement())
  requestNo         String              @unique
  prescriptionId    Int
  patientId         Int
  requestType       RefillRequestType
  status            RefillRequestStatus @default(SUBMITTED)
  requestedByUserId Int
  reviewedByUserId  Int?
  rejectionReason   String?
  notes             String?
  orderId           Int?                @unique
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("RefillRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy   User?        @relation("RefillReviewedBy", fields: [reviewedByUserId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([prescriptionId])
  @@index([patientId])
  @@index([status])
  @@index([requestType])
  @@index([prescriptionId, status])
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  occurredAt   DateTime @default(now())
  actorUserId  Int?
  actorRole    String
  action       String
  entityType   String
  entityId     Int
  metadata     Json?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
}

enum MedicationStatus {
  ACTIVE
  INACTIVE
}

model Medication {
  id               Int              @id @default(autoincrement())
  sku              String           @unique
  name             String
  unit             String
  quantityOnHand   Int              @default(0)
  reorderLevel     Int              @default(0)
  reorderQuantity  Int              @default(0)
  status           MedicationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  stockMovements         StockMovement[]
  replenishmentRequests  ReplenishmentRequest[]

  @@index([status])
  @@index([name])
  @@index([quantityOnHand])
}

enum ReplenishmentRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  RECEIVED
}

model ReplenishmentRequest {
  id                Int                        @id @default(autoincrement())
  requestNo         String                     @unique
  medicationId      Int
  requestedQuantity Int
  status            ReplenishmentRequestStatus @default(SUBMITTED)
  requestedByUserId Int
  reviewedByUserId  Int?
  rejectionReason   String?
  notes             String?
  receivedQuantity  Int?
  reviewedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  medication  Medication      @relation(fields: [medicationId], references: [id])
  requestedBy User            @relation("ReplenishmentRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy  User?           @relation("ReplenishmentReviewedBy", fields: [reviewedByUserId], references: [id])
  movements   StockMovement[]

  @@index([medicationId])
  @@index([status])
  @@index([medicationId, status])
}

model StockMovement {
  id                     Int      @id @default(autoincrement())
  medicationId           Int
  movementType           String
  quantityDelta          Int
  quantityBefore         Int
  quantityAfter          Int
  reason                 String?
  actorUserId            Int
  replenishmentRequestId Int?
  createdAt              DateTime @default(now())

  medication           Medication            @relation(fields: [medicationId], references: [id])
  actor                User                  @relation(fields: [actorUserId], references: [id])
  replenishmentRequest ReplenishmentRequest? @relation(fields: [replenishmentRequestId], references: [id])

  @@index([medicationId])
  @@index([createdAt])
  @@index([replenishmentRequestId])
}

enum LabTestOrderStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_AVAILABLE
  ACKNOWLEDGED
  CANCELLED
  REJECTED
}

enum LabResultFlag {
  NORMAL
  ABNORMAL
  CRITICAL
}

model LabTestOrder {
  id                       Int                @id @default(autoincrement())
  orderNo                  String             @unique
  patientId                Int
  doctorId                 Int
  appointmentId            Int?
  testName                 String
  status                   LabTestOrderStatus @default(REQUESTED)
  orderedAt                DateTime           @default(now())
  notes                    String?
  createdByUserId          Int
  resultSummary            String?
  resultFlag               LabResultFlag?
  resultOriginalName       String?
  resultStoredName         String?
  resultMimeType           String?
  resultSize               Int?
  resultFilePath           String?
  resultUploadedAt         DateTime?
  resultUploadedByUserId   Int?
  resultDocumentId         Int?               @unique
  acknowledgedByUserId     Int?
  acknowledgedAt           DateTime?
  rejectionReason          String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  patient              Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor               Doctor           @relation(fields: [doctorId], references: [id])
  appointment          Appointment?     @relation(fields: [appointmentId], references: [id])
  createdBy            User             @relation("LabTestOrderCreatedBy", fields: [createdByUserId], references: [id])
  resultUploadedBy     User?            @relation("LabTestOrderResultUploadedBy", fields: [resultUploadedByUserId], references: [id])
  acknowledgedBy       User?            @relation("LabTestOrderAcknowledgedBy", fields: [acknowledgedByUserId], references: [id])
  resultDocument       PatientDocument? @relation("LabTestOrderResultDocument", fields: [resultDocumentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([orderedAt])
  @@index([patientId, status])
}